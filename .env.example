# Copy to .env and replace every secret (e.g. `openssl rand -hex 24`). Never commit .env.
# The database passwords are applied only when the data volume is first created (docker/postgres/initdb).

# PostgreSQL superuser (only used by the database container itself).
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
# Schema owner "nexus": used only by the one-shot migrate service.
DB_OWNER_PASSWORD=change-me-owner
# Runtime role "nexus_app": used by the API (no SUPERUSER, no BYPASSRLS).
DB_APP_PASSWORD=change-me-app

# Commercial name shown in the UI (baked into the web build) and returned by the API.
PRODUCT_NAME=Nexus Business

# Host port of the web app.
WEB_PORT=8080

# Expose the API documentation at /swagger (keep false in production).
SWAGGER_ENABLED=false

# Requests per minute and client IP. Raise it only for automated end-to-end runs.
RATE_LIMIT_PER_IP_PER_MINUTE=600

# Per-IP budget for sign-in, registration and password recovery (per minute).
RATE_LIMIT_CREDENTIALS_PER_MINUTE=10

# Public URL of the web app, used in e-mailed links. Must match how users reach the site.
PUBLIC_BASE_URL=http://localhost:8080

# Outgoing e-mail. The defaults deliver to the local Mailpit catcher (UI on http://127.0.0.1:8025);
# for real delivery set your provider's host/port/credentials, SMTP_ENABLE_SSL=true and remove COMPOSE_PROFILES.
COMPOSE_PROFILES=mailpit
EMAIL_FROM=no-reply@example.com
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=false
MAILPIT_UI_PORT=8025
